diff --git a/helixon-app/app/admin/pentester/page.js b/helixon-app/app/admin/pentester/page.js
new file mode 100644
index 0000000..4aa0ece
--- /dev/null
+++ b/helixon-app/app/admin/pentester/page.js
@@ -0,0 +1,319 @@
+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+
+import { PageHeader, KpiCard, Panel, BarList } from "../_shared/ui";
+import { useAdminTraffic } from "../_shared/hooks";
+
+// Human-readable labels for the signal names scoreRequest() (lib/security/
+// threat-score.js) attaches to a request. Kept here rather than in the
+// scoring lib so the lib stays UI-agnostic.
+const SIGNAL_LABELS = {
+  "path-traversal": "Path traversal (../, %2e%2e)",
+  "sql-injection-probe": "SQL injection probe",
+  "xss-probe": "XSS probe",
+  "sensitive-path-probe": "Sensitive path probe (.git, .env, wp-admin…)",
+  "scanner-ua": "Known scanner user-agent",
+  "blocked-by-control": "Blocked by existing control",
+  "sensitive-write": "Write attempt on auth/admin route",
+};
+
+// A dated, curated findings log — separate from live telemetry below, since
+// "what did we find and fix" is a different question from "what's
+// happening on the wire right now", and a pentester needs both. Update this
+// list by hand as findings are opened/closed; it is not auto-derived.
+const FINDINGS_LOG = [
+  {
+    title: "CSRF protection missing on all mutating admin routes",
+    severity: "critical",
+    status: "fixed",
+    date: "2026-09-03",
+    detail:
+      "No token of any kind was sent or checked on POST/PATCH/DELETE to /api/admin/traffic, /users, or /employees — any page the admin's browser rendered could forge those requests. Fixed with a double-submit cookie token (lib/admin-csrf.js), verified on every mutating handler.",
+  },
+  {
+    title: "SEO/SOC dashboards 403'd for every admin (auth wiring bug)",
+    severity: "high",
+    status: "fixed",
+    date: "2026-09-03",
+    detail:
+      "/api/admin/ops checked for a Supabase Bearer token that the real (cookie-based) admin login never produces. Not an access gap — the opposite: the sales, ops, SEO, and investigate pages were unusable. Fixed by switching to requireAdminSession(), the same check every other admin route uses.",
+  },
+  {
+    title: "Password reset and IP-block reason used window.prompt()",
+    severity: "medium",
+    status: "fixed",
+    date: "2026-09-03",
+    detail:
+      "New passwords were shown in plaintext in a native browser dialog with no confirm field — visible on screen-share, no typo protection. Replaced with an in-app modal requiring the password to be typed twice, masked (app/admin/_shared/modal.js).",
+  },
+  {
+    title: "Dead employees/provision route with its own auth implementation",
+    severity: "low",
+    status: "fixed",
+    date: "2026-09-03",
+    detail:
+      "A third, separately-implemented Bearer-token auth check, called by no client code or cron. Unused code with its own auth logic is unaudited attack surface by definition. Removed rather than patched.",
+  },
+  {
+    title: "/api/internal/edge-log accepts unauthenticated POSTs",
+    severity: "low",
+    status: "open",
+    date: "2026-09-03",
+    detail:
+      "Called by proxy.ts on every request with no auth guard, by design, so it can log traffic before a session exists. It inserts caller-supplied ip/ua/path/country/lat/lon directly into request_logs. An external caller can POST directly to this route (bypassing normal request flow) and insert arbitrary rows — a log-forgery path that could pollute the threat-scoring and geo data every other page on this admin panel relies on. Worth adding an internal-only check (e.g. a shared secret header, or Vercel's trusted-IP header, both already noted as options in the route's own comments) before treating this data as fully trustworthy.",
+  },
+];
+
+const SEVERITY_ORDER = { critical: 0, high: 1, medium: 2, low: 3 };
+
+function severityFromScore(score) {
+  if (score >= 70) return "critical";
+  if (score >= 40) return "high";
+  if (score >= 20) return "medium";
+  return "low";
+}
+
+function SeverityPill({ severity }) {
+  const tone = severity === "critical" || severity === "high" ? "bad" : severity === "medium" ? "warn" : "good";
+  return <span className={`pill ${tone}`}>{severity}</span>;
+}
+
+function StatusPill({ status }) {
+  return <span className={`pill ${status === "open" ? "warn" : "good"}`}>{status}</span>;
+}
+
+export default function PentesterPage() {
+  const [data, setData] = useState(null);
+  const [error, setError] = useState("");
+  const [loading, setLoading] = useState(true);
+  const [query, setQuery] = useState("");
+
+  const { block, busy: blocking } = useAdminTraffic("24h");
+
+  useEffect(() => {
+    fetch("/api/admin/ops", { cache: "no-store" })
+      .then(async (r) => {
+        const body = await r.json();
+        if (!r.ok) throw new Error(body.error || "Request failed");
+        return body;
+      })
+      .then(setData)
+      .catch((e) => setError(e.message))
+      .finally(() => setLoading(false));
+  }, []);
+
+  const threats = data?.threats || [];
+  const ipInvestigations = data?.ipInvestigations || [];
+  const kpis = data?.kpis;
+
+  const signalCounts = useMemo(() => {
+    const counts = new Map();
+    for (const row of threats) {
+      for (const signal of row.threat?.signals || []) {
+        counts.set(signal, (counts.get(signal) || 0) + 1);
+      }
+    }
+    return [...counts.entries()]
+      .map(([signal, count]) => ({ name: SIGNAL_LABELS[signal] || signal, count }))
+      .sort((a, b) => b.count - a.count);
+  }, [threats]);
+
+  const scannerUaCount = useMemo(
+    () => threats.filter((row) => (row.threat?.signals || []).includes("scanner-ua")).length,
+    [threats],
+  );
+  const sensitivePathCount = useMemo(
+    () => threats.filter((row) => (row.threat?.signals || []).includes("sensitive-path-probe")).length,
+    [threats],
+  );
+  const criticalCount = threats.filter((r) => r.threat.score >= 70).length;
+  const highCount = threats.filter((r) => r.threat.score >= 40 && r.threat.score < 70).length;
+
+  const q = query.trim().toLowerCase();
+  const visibleThreats = threats
+    .filter(
+      (row) =>
+        !q ||
+        `${row.ip} ${row.path} ${row.user_agent} ${row.country} ${(row.threat.signals || []).join(" ")}`
+          .toLowerCase()
+          .includes(q),
+    )
+    .slice(0, 150);
+
+  const sortedFindings = [...FINDINGS_LOG].sort(
+    (a, b) => SEVERITY_ORDER[a.severity] - SEVERITY_ORDER[b.severity],
+  );
+
+  return (
+    <>
+      <PageHeader
+        title="Pentester"
+        description="Live exploit-attempt telemetry, scored and classified, plus the standing findings log for this app."
+      />
+
+      {error && <div className="notice error section">{error}</div>}
+
+      {loading ? (
+        <div className="empty section">Loading…</div>
+      ) : (
+        <>
+          <div className="kpi-grid cols-6">
+            <KpiCard label="Critical (≥70)" value={criticalCount} tone="var(--critical)" />
+            <KpiCard label="High (40–69)" value={highCount} tone="var(--warn)" />
+            <KpiCard label="Flagged requests" value={kpis?.threats ?? threats.length} />
+            <KpiCard label="Attacking IPs tracked" value={ipInvestigations.length} />
+            <KpiCard label="Scanner user-agents" value={scannerUaCount} tone={scannerUaCount ? "var(--warn)" : undefined} />
+            <KpiCard label="Sensitive-path probes" value={sensitivePathCount} tone={sensitivePathCount ? "var(--warn)" : undefined} />
+          </div>
+
+          <div className="notice section">
+            Scoring is signature-based (path/UA pattern matching in
+            lib/security/threat-score.js) — treat this as a triage aid, not a
+            verdict. A high score means "worth a human look," not "confirmed
+            malicious."
+          </div>
+
+          <div className="grid-2 section">
+            <Panel title="Attack technique breakdown" sub="Signals seen across flagged requests, most common first.">
+              <BarList items={signalCounts} limit={8} />
+            </Panel>
+
+            <Panel title="Top offending IPs" sub="Ranked by peak threat score, then request volume.">
+              {ipInvestigations.length === 0 ? (
+                <div className="empty">No flagged IPs in the tracked window.</div>
+              ) : (
+                <div className="table-wrap">
+                  <table className="table">
+                    <thead>
+                      <tr>
+                        <th>IP</th>
+                        <th>Peak score</th>
+                        <th>Requests</th>
+                        <th>Blocked</th>
+                        <th>Signals</th>
+                        <th></th>
+                      </tr>
+                    </thead>
+                    <tbody>
+                      {ipInvestigations.slice(0, 15).map((row) => (
+                        <tr key={row.ip}>
+                          <td className="mono">{row.ip}</td>
+                          <td>
+                            <SeverityPill severity={severityFromScore(row.maxScore)} />
+                          </td>
+                          <td className="mono">{row.requests}</td>
+                          <td className="mono" style={row.blocked ? { color: "var(--critical)" } : undefined}>
+                            {row.blocked}
+                          </td>
+                          <td className="muted">{row.signals.slice(0, 2).join(", ") || "—"}</td>
+                          <td>
+                            <button
+                              className="btn small danger"
+                              disabled={blocking || row.ip === "unknown"}
+                              onClick={() => block(row.ip)}
+                            >
+                              Block
+                            </button>
+                          </td>
+                        </tr>
+                      ))}
+                    </tbody>
+                  </table>
+                </div>
+              )}
+            </Panel>
+          </div>
+
+          <Panel
+            title="Flagged request log"
+            sub="Individual requests scoring ≥20. Search by IP, path, user-agent, country, or signal."
+            className="section"
+          >
+            <input
+              className="search-input"
+              placeholder="Filter by IP, path, UA, country, or signal…"
+              value={query}
+              onChange={(e) => setQuery(e.target.value)}
+              style={{ marginBottom: 14, maxWidth: 420 }}
+            />
+
+            {visibleThreats.length === 0 ? (
+              <div className="empty">No flagged requests match.</div>
+            ) : (
+              <div className="table-wrap">
+                <table className="table">
+                  <thead>
+                    <tr>
+                      <th>Time</th>
+                      <th>IP</th>
+                      <th>Country</th>
+                      <th>Method</th>
+                      <th>Path</th>
+                      <th>Severity</th>
+                      <th>Signals</th>
+                      <th>Blocked</th>
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {visibleThreats.map((row, i) => (
+                      <tr key={`${row.ip}-${row.created_at}-${i}`}>
+                        <td className="mono">
+                          {row.created_at ? new Date(row.created_at).toLocaleString() : "—"}
+                        </td>
+                        <td className="mono">{row.ip}</td>
+                        <td className="muted">{row.country || "—"}</td>
+                        <td className="mono">{row.method}</td>
+                        <td className="mono" title={row.path}>
+                          {row.path}
+                        </td>
+                        <td>
+                          <SeverityPill severity={severityFromScore(row.threat.score)} />
+                        </td>
+                        <td className="muted">{(row.threat.signals || []).join(", ") || "—"}</td>
+                        <td className="mono" style={row.blocked ? { color: "var(--critical)" } : undefined}>
+                          {row.blocked ? "yes" : "no"}
+                        </td>
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+            )}
+          </Panel>
+
+          <Panel
+            title="Findings log"
+            sub="Curated, dated record of security findings on this app — separate from live telemetry above."
+            className="section"
+          >
+            <div className="findings-list">
+              {sortedFindings.map((finding) => (
+                <div className="finding-row" key={finding.title}>
+                  <div className="finding-row-head">
+                    <SeverityPill severity={finding.severity} />
+                    <b>{finding.title}</b>
+                    <StatusPill status={finding.status} />
+                    <span className="muted mono" style={{ marginLeft: "auto" }}>
+                      {finding.date}
+                    </span>
+                  </div>
+                  <p className="muted" style={{ margin: "6px 0 0" }}>
+                    {finding.detail}
+                  </p>
+                </div>
+              ))}
+            </div>
+          </Panel>
+
+          <div className="footer-note section">
+            Raw response bodies are not stored — CVs, tokens, credentials, and
+            generated documents never enter request_logs, so this view is
+            safe to share with an external pentester without a separate
+            redaction pass.
+          </div>
+        </>
+      )}
+    </>
+  );
+}
