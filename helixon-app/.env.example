# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase (service-role client used by almost every backend route)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Clerk (identity/auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_signing_secret

# Stripe (billing)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
STRIPE_PRICE_INDIVIDUAL=your_stripe_individual_plan_price_id
STRIPE_PRICE_AGENCY=your_stripe_agency_plan_price_id

# CV analysis pipeline
ANTHROPIC_API_KEY=your_anthropic_api_key

# Site gate (under-construction password lock)
SITE_GATE_PASSWORD=your_gate_password
SITE_GATE_SECRET=a_long_random_string

# Admin portal (separate from Clerk customer auth)
ADMIN_SESSION_SECRET=a_long_random_string
# Hides the default /admin/login route (proxy.ts): the login page is served ONLY
# at /<this value>, and every other /admin and /api/admin URL returns a plain 404
# without an admin session. 8+ characters: letters, digits, - or _. Pick something
# unguessable (e.g. ops-4kx9p2q). Leave unset to keep the default /admin/login.
ADMIN_LOGIN_SLUG=
# Admin password hashes: prefer bcrypt (node scripts/hash-admin-password.js);
# legacy sha256 hex digests are still accepted.
# ADMIN_USERS=alice,bob
# ADMIN_PASSWORD_HASH_ALICE=$2b$12$...

# Redis (rate limiting)
REDIS_URL=your_redis_connection_url

# Internal edge-log shared secret (proxy.ts -> /api/internal/edge-log)
INTERNAL_EDGE_LOG_SECRET=a_long_random_string
