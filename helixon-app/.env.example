# PostHog browser analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase (service-role client used by almost every backend route)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key
# Database-level agency separation (lib/agency-db.js, docs/runbook.md).
# Off unless both are set. Apply migration 20261005000000 first.
SUPABASE_JWT_SECRET=your_supabase_legacy_jwt_secret
SUPABASE_AGENCY_RLS=

# Clerk (identity/auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_signing_secret
# Clerk application paths - keep in step with Clerk dashboard > Configure > Paths.
# (app/layout.js also sets these on <ClerkProvider>.)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/login

# Stripe (billing)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
STRIPE_PRICE_INDIVIDUAL=your_stripe_individual_plan_price_id
STRIPE_PRICE_AGENCY=your_stripe_agency_plan_price_id

# CV analysis pipeline
ANTHROPIC_API_KEY=your_anthropic_api_key

# Embedding fallback for skills the static taxonomy can't match
# (lib/cv-analysis/scoring/embeddingMatcher.js). Anthropic has no embeddings
# endpoint of its own; Voyage is Anthropic's own recommended embeddings
# partner. Optional - if unset, skill matching just falls back to
# taxonomy-only, it doesn't break.
VOYAGE_API_KEY=your_voyage_api_key

# Used only by the website chat assistant (app/api/assistant) - kept
# separate from the CV analysis pipeline above, which is Anthropic/Voyage
# only.
GEMINI_API_KEY=your_gemini_api_key

# Site gate (under-construction password lock)
SITE_GATE_PASSWORD=your_gate_password
SITE_GATE_SECRET=a_long_random_string

# Admin portal (separate from Clerk customer auth)
ADMIN_SESSION_SECRET=a_long_random_string
# Hides the default /admin/login route (proxy.ts): the login page is served ONLY
# at /<this value>, and every other /admin and /api/admin URL returns a plain 404
# without an admin session. 8+ characters: letters, digits, - or _. Pick something
# unguessable (e.g. ops-4kx9p2q). Leave unset to keep the default /admin/login.
ADMIN_LOGIN_SLUG=
# Admin password hashes: prefer bcrypt (node scripts/hash-admin-password.js);
# legacy sha256 hex digests are still accepted.
# ADMIN_USERS=alice,bob
# ADMIN_PASSWORD_HASH_ALICE=$2b$12$...
# Signs just this admin's existing sessions out (any other admin is
# unaffected). Set alongside a rotated ADMIN_PASSWORD_HASH_ALICE whenever
# that admin's password changes, to an ISO date or epoch ms at or after now.
# ADMIN_SESSION_VALID_AFTER_ALICE=
# Emergency-only: signs EVERY admin out at once. Leave unset day to day.
# ADMIN_SESSIONS_VALID_AFTER=

# Redis (rate limiting)
REDIS_URL=your_redis_connection_url

# Internal edge-log shared secret (proxy.ts -> /api/internal/edge-log)
INTERNAL_EDGE_LOG_SECRET=a_long_random_string

# Data retention cron (vercel.json -> /api/cron/data-retention). Vercel sends
# this as `Authorization: Bearer <value>` automatically once it's set as a
# project env var - see https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=a_long_random_string

# Resend (contact form, demo requests, candidate emails, security alerts)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Helixon <noreply@helixon.co.uk>
# Replies to emails sent from Helixon, and BCC logging (log+<token>@...):
# a Resend receiving domain, and the signing secret of the Resend webhook
# that posts "email.received" to <NEXT_PUBLIC_SITE_URL>/api/webhooks/resend-inbound
RESEND_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=

# Firewall (lib/security/firewall.js) - auto-blocks and alerts on requests
# scored by lib/security/threat-score.js. Leave the thresholds unset to use
# the defaults (30 to auto-block, 20 to just alert - see that file for why).
SECURITY_ALERT_EMAIL=you@helixon.co.uk
# FIREWALL_BLOCK_THRESHOLD=30
# FIREWALL_ALERT_THRESHOLD=20

# Google Calendar two-way sync for the employee shared calendar
# (lib/google-calendar.js, app/employee/calendar). Optional - the calendar
# itself and its ICS "subscribe by URL" feed work with neither of these
# set; only the "Connect Google Calendar" button needs them. Create an
# OAuth 2.0 Client ID (Web application) in Google Cloud Console with
# Authorized redirect URI: <your site>/api/employee/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret

# Integrations (Settings → Integrations). Each one is optional and stays
# "Not set up" until its variables exist. Register each app's redirect URI
# as <NEXT_PUBLIC_SITE_URL>/api/integrations/oauth/<provider>/callback.
# Tokens are stored encrypted with this key - 32 random bytes:
#   openssl rand -hex 32
INTEGRATIONS_ENCRYPTION_KEY=
# Xero (developer.xero.com) - provider "xero"
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# XERO_SALES_ACCOUNT_CODE=200        # revenue account for invoice lines
# XERO_INVOICE_STATUS=DRAFT          # DRAFT, SUBMITTED or AUTHORISED
# XERO_SCOPES=                       # override if your Xero app uses granular scopes
# QuickBooks Online (developer.intuit.com) - provider "quickbooks"
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox     # while testing
# QUICKBOOKS_ITEM_ID=1               # the Item (product/service) on invoice lines
# QUICKBOOKS_TAX_CODE_VAT=           # tax code ids, if your company needs them
# QUICKBOOKS_TAX_CODE_NONE=
# Gmail mailbox sync (Google Cloud: OAuth client + Gmail API) - provider "gmail"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Outlook / Microsoft 365 mailbox sync (Entra app, Mail.Read) - provider "outlook"
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# OUTLOOK_TENANT=common
# MAILBOX_LOOKBACK_DAYS=30           # how far back the first sync reads
# Texting (Twilio). Point the number's incoming-message webhook at
# <NEXT_PUBLIC_SITE_URL>/api/webhooks/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=      # instead of TWILIO_FROM_NUMBER
# SMS_DEFAULT_COUNTRY_CODE=44        # for numbers saved as 07...
