+"use client";
+
+import { useState } from "react";
+
+import { PageHeader, KpiCard, RangeControl } from "../_shared/ui";
+import { useAdminEmployees } from "../_shared/hooks";
+import SalesMarketingPanel from "./sales-marketing-panel";
+
+const roles = [
+  "super_admin",
+  "admin",
+  "sales",
+  "support",
